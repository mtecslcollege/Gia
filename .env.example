# Copy to .env for local development (never commit .env). Same names go into Netlify > Site configuration > Environment variables.
# From Supabase: Project Settings > API (URL, publishable/anon key) and the secret service_role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# SECRET. Server only. Never put this in a VITE_ variable and never in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Any long random string; used to hash visitor network addresses for rate limits.
RESULT_CLIENT_SALT=change-me-to-a-long-random-string
